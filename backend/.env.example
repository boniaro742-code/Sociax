# Copy this file to ".env" (same folder) and fill the values. ".env" is private: never upload it to GitHub.

# --- Cloudinary (photos + videos) ---
CLOUDINARY_CLOUD_NAME=blquould
CLOUDINARY_API_KEY=PASTE_CLOUDINARY_API_KEY_HERE
CLOUDINARY_API_SECRET=PASTE_CLOUDINARY_API_SECRET_HERE

# --- AI: Grok leads, Gemini assists, Claude is the third provider ---
XAI_API_KEY=PASTE_NEW_XAI_KEY_HERE
GEMINI_API_KEY=PASTE_NEW_GEMINI_KEY_HERE
XAI_MODEL=grok-4.6
GEMINI_MODEL=gemini-2.5-flash
# Claude (Anthropic). Get a key at console.anthropic.com. Server only, never in the app.
ANTHROPIC_API_KEY=PASTE_ANTHROPIC_KEY_HERE
ANTHROPIC_MODEL=claude-sonnet-5-5
# Who answers first. Default: grok,gemini,claude. To let Claude lead: claude,grok,gemini
# AI_PROVIDER_ORDER=grok,gemini,claude

# Free AI requests per 48 hours. TEMPORARY testing value: you still have to decide the real number.
FREE_AI_REQUESTS=10

# For testing without Firebase only (never in production):
# DEV_AUTH=1

# --- Chapa payments (TEST mode only, server only) ---
# Paste your Chapa TEST secret key (starts with CHASECK_TEST) in the real ".env" file, NEVER here and never in chat.
CHAPA_SECRET_KEY=PASTE_CHAPA_TEST_SECRET_KEY_HERE
# Optional: page where Chapa sends the user back after checkout (a redirect alone never grants Pro).
# CHAPA_RETURN_URL=
# Live payments stay OFF. Do not set this until the owner approves going live:
# CHAPA_ALLOW_LIVE=1

# --- For You ranker (optional). Default = the plan's starting weights (a hypothesis, not a proven value). ---
# All six keys are required and must add up to 1.0, otherwise the defaults are used (a warning is logged, no values).
# RANK_WEIGHTS=interest=0.30,watch=0.20,fresh=0.15,engage=0.15,follow=0.10,diversity=0.10

# Step 41: AdMob daily reset. The ad day starts at 00:00 UTC + this many minutes (default 0).
# AD_DAY_UTC_OFFSET_MINUTES=0

# --- Step 48: optional Go ranking engine (backend-go/). Empty URL = Python ranks by itself (the default, nothing else needed). ---
# RANK_ENGINE_URL=https://YOUR-ENGINE.onrender.com
# RANK_ENGINE_TOKEN=THE_SAME_SECRET_AS_ENGINE_TOKEN_OF_THE_ENGINE_24_CHARS_OR_MORE
# RANK_ENGINE_TIMEOUT_MS=800
