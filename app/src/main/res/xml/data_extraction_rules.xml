<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the App Lock verifier is not copied to the cloud or to another phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sociax_lock.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sociax_lock.xml" />
    </device-transfer>
</data-extraction-rules>
